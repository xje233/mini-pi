# 每个 provider 一个 Key（对照 pi: env-api-keys.ts 的映射表），共存互不影响
DEEPSEEK_API_KEY=sk-xxx
#GLM_API_KEY=xxx
#MOONSHOT_API_KEY=xxx

# —— 以下全部可选（默认值见括号）——
#LLM_BASE_URL=https://api.deepseek.com        # 任何 OpenAI 兼容端点（路径自动补全）
#LLM_TIMEOUT_MS=120000                        # 请求超时（含流式读取全程）
#LLM_MAX_RETRIES=3                            # 连接阶段失败重试次数（流开始后不重试）
#LLM_MAX_TOKENS=                              # 输出 token 上限（provider 默认）
#MAX_TURNS=30                                 # 单任务最大 LLM 回合数（防失控）
#COMPACT_RESERVE_TOKENS=16384                  # 压缩触发线预留空间（对照 pi）
#COMPACT_KEEP_RECENT_TOKENS=20000             # 压缩时必保留的近期 token（对照 pi）
#DENY_TOOLS=run_command,shell:*               # 暴露过滤：命中的工具从请求中移除（模型看不见）
#ENFORCE_RULES=[{"tool":"run_command","argsRegex":"\\brm\\b","reason":"禁止 rm"}]  # 执行门控（参数级模式）
#SYSTEM_PROMPT=                               # 覆盖默认 system prompt
